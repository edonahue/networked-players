/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

# Advertise the LLM/agent context file for HTTP Link-based discovery.
/
  Link: </llms.txt>; rel="service-doc"; type="text/plain"

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Data artifacts are NOT content-addressed: `*.v1.json` names version the
# schema, not the contents, and rebuilds overwrite them in place. A long
# max-age would let a browser pair freshly deployed HTML with yesterday's
# data, so revalidate every time (same policy as HTML). The ETag makes an
# unchanged file a cheap 304.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
