---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpinningRecord from '../components/SpinningRecord.astro';
import AlbumCard from '../components/AlbumCard.astro';
import site from '../data/site.json';
import type { ChallengeV2 } from '../data/challenge';
import type { ContributorIndex } from '../data/contributors';
import type { Membership } from '../data/albumRecord';
import { homeFeatures } from '../data/homeFeatures';
import challengeData from '../../public/data/challenge.v3.json';
import membershipData from '../../public/data/albums/credit-membership.v1.json';
import contributorIndexData from '../../public/data/contributors/index.v1.json';

const { hero } = site;

const challenge = challengeData as ChallengeV2;
const albums = challenge.albums;
const contributorIdsWithPages = new Set(
  (contributorIndexData as ContributorIndex).contributors.map((c) => c.artist_id),
);

// Both picks are deterministic functions of the credit-membership artifact
// (see data/homeFeatures.ts): the landing record is the one with the most
// documented connections onward; the example is the cross-artist pair of
// records that share the most documented performers.
const { landing, pair } = homeFeatures(membershipData as Membership, albums);
const SHOWN_PLAYERS = 6;
const sharedShown = pair ? pair.shared.slice(0, SHOWN_PLAYERS) : [];
const sharedMore = pair ? pair.shared.length - sharedShown.length : 0;
---

<BaseLayout>
  <section class="hero hero--split shell">
    <div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.headline}</h1>
      <p class="lede">{hero.lede}</p>
      <div class="hero-actions">
        <a class="button primary" href={`/explore/${landing.album.id}/`} data-testid="home-explore-cta">
          Explore {landing.album.title}<span class="button__by">, {landing.album.artist}</span>
        </a>
        <a class="button" href="/play/daily/">Today's connection</a>
      </div>
      <p class="callout home-rule" data-testid="home-rule">
        A connection means two people are documented performing on the same recording. Producers
        and engineers appear in the credits, but don't make a connection.
      </p>
    </div>
    <SpinningRecord />
  </section>

  <section class="section shell" id="start" aria-labelledby="start-title">
    <div class="section-heading">
      <p class="eyebrow">Start here</p>
      <h2 id="start-title">Pick a way in.</h2>
    </div>
    <a class="feature-card home-explore" data-tone="teal" href="/explore/">
      <span class="kicker">The main way in</span>
      <h3>Explore</h3>
      <p>
        Open any record and follow the players on it to the next record they played on. Every
        step shows its credits.
      </p>
    </a>
    <div class="feature-grid home-secondary">
      <a class="feature-card" data-tone="gold" href="/albums/">
        <span class="kicker">The shelf</span>
        <h3>Records</h3>
        <p>All {albums.length} records, with who played on each and where they lead.</p>
      </a>
      <a class="feature-card" data-tone="rust" href="/contributors/">
        <span class="kicker">The people</span>
        <h3>Players</h3>
        <p>Everyone documented, with the records they connect.</p>
      </a>
    </div>
    <div class="home-play" data-testid="home-play">
      <h3 class="home-play__title"><a href="/play/">Play</a></h3>
      <ul class="home-play__list">
        <li><a href="/play/daily/">Today's Connection</a></li>
        <li><a href="/play/connect/">Connect Two Records</a></li>
        <li><a href="/play/routes/">Record Routes</a></li>
        <li><a href="/play/connection/">Connection Guesser</a></li>
      </ul>
    </div>
  </section>

  {
    pair && (
      <section class="section shell" id="example" aria-labelledby="example-title" data-testid="home-example">
        <div class="section-heading">
          <p class="eyebrow">One connection</p>
          <h2 id="example-title">Two records, linked by the people who played on both.</h2>
        </div>
        <div class="album-grid">
          <AlbumCard album={pair.a} />
          <AlbumCard album={pair.b} />
        </div>
        <p class="lede home-shared" data-testid="home-shared">
          Documented performing on both:{' '}
          {sharedShown.map((p, i) => (
            <span>{contributorIdsWithPages.has(p.artistId) ? <a href={`/contributors/${p.artistId}/`}>{p.name}</a> : p.name}{i < sharedShown.length - 1 ? ', ' : ''}</span>
          ))}
          {sharedMore > 0 && ` and ${sharedMore} more`}.
        </p>
        <div class="hero-actions" style="margin-top:0">
          <a class="button primary" href={`/play/connect/?a=${pair.a.id}&b=${pair.b.id}`}>
            See the route in Connect
          </a>
        </div>
      </section>
    )
  }

  <section class="section shell" aria-labelledby="state-title">
    <div class="section-heading">
      <p class="eyebrow">What's real here</p>
      <h2 id="state-title">Documented, not inferred.</h2>
      <p class="lede">
        {albums.length} records and the credits behind them, from Discogs' monthly CC0 data
        (snapshot {challenge.provenance.snapshot_date}). We don't infer influence or
        relationships from a shared credit. <a href="/about/">Read the full picture</a>.
      </p>
    </div>
  </section>
</BaseLayout>
