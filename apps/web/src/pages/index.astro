---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpinningRecord from '../components/SpinningRecord.astro';
import AlbumCard from '../components/AlbumCard.astro';
import site from '../data/site.json';
import type { ChallengeV2 } from '../data/challenge';
import type { Contributor, ContributorIndex } from '../data/contributors';
import challengeData from '../../public/data/challenge.v2.json';
import contributorIndexData from '../../public/data/contributors/index.v1.json';
import { connectedCatalogAlbums } from '../data/connectedAlbums';
import { findBehindTheGlassPath } from '../data/featuredExamples';

const { hero, focus } = site;

const challenge = challengeData as ChallengeV2;
const albums = connectedCatalogAlbums(challenge);
const contributorIndex = contributorIndexData as ContributorIndex;

// Deterministic, not random: challenge.paths[0] is a real documented route,
// content-hash versioned along with the rest of challenge.v2.json (ADR
// 0043) -- its position in the array is the artifact's own stable order,
// not a pick made at render time.
const featuredPath = challenge.paths[0];
const albumsById = new Map(challenge.albums.map((album) => [album.id, album]));
const featuredFrom = albumsById.get(featuredPath.from_album_id);
const featuredTo = albumsById.get(featuredPath.to_album_id);

// Same "deterministic, not random" discipline as featuredPath above: the
// first contributor (the index's own artist_id-sorted order) that has both
// a real ADR 0060 interesting_next_step and a connected album to launch
// Explore from. Content-hash versioned along with the rest of
// contributor-index-v1, not a pick made at render time.
const featuredContributor = contributorIndex.contributors.find(
  (c): c is Contributor => c.interesting_next_step !== null && c.albums.length > 0,
);
const contributorById = new Map(contributorIndex.contributors.map((c) => [c.artist_id, c]));
const featuredNeighbor = featuredContributor
  ? contributorById.get(featuredContributor.interesting_next_step!.artist_id)
  : undefined;

const behindTheGlassPath = findBehindTheGlassPath(challenge);
const behindTheGlassFrom = behindTheGlassPath
  ? albumsById.get(behindTheGlassPath.from_album_id)
  : undefined;
const behindTheGlassTo = behindTheGlassPath
  ? albumsById.get(behindTheGlassPath.to_album_id)
  : undefined;
---

<BaseLayout>
  <section class="hero hero--split shell">
    <div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.headline}</h1>
      <p class="lede">{hero.lede}</p>
      <div class="hero-actions">
        <a class="button primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="button" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
    </div>
    <SpinningRecord />
  </section>

  <section class="section shell" id="ways-to-explore" aria-labelledby="ways-title">
    <div class="section-heading">
      <p class="eyebrow">Start here</p>
      <h2 id="ways-title">Four ways into the graph.</h2>
      <p class="lede">
        Every mode below runs on the same credit data. Pick the one that matches what you're
        curious about.
      </p>
    </div>
    <div class="feature-grid">
      <a class="feature-card" data-tone="teal" href="/play/daily/">
        <span class="kicker">One a day</span>
        <h3>Today's Connection</h3>
        <p>A frozen, shared daily route between two records — the same one for everyone.</p>
      </a>
      <a class="feature-card" data-tone="gold" href="/play/connect/">
        <span class="kicker">Pick any two</span>
        <h3>Connect Two Records</h3>
        <p>Choose any two albums and search for a documented route between them.</p>
      </a>
      <a class="feature-card" data-tone="rust" href="/play/routes/">
        <span class="kicker">Guided</span>
        <h3>Record Routes</h3>
        <p>Curated multi-hop routes between records, with the evidence for every step.</p>
      </a>
      <a class="feature-card" data-tone="teal" href="/explore/">
        <span class="kicker">Open-ended</span>
        <h3>Explore</h3>
        <p>Step into one album's bounded credit network and follow it wherever it leads.</p>
      </a>
    </div>
    <p class="lede" style="margin-top:20px">
      Want the full shelf? <a href="/play/">See every way to play</a>.
    </p>
  </section>

  {
    featuredContributor && (
      <section class="section shell" id="people" aria-labelledby="people-title">
        <div class="section-heading">
          <p class="eyebrow">Follow the credits</p>
          <h2 id="people-title">Every record has people behind it.</h2>
          <p class="lede">
            Each album page lists who's documented on it. Open any name to land on their own
            page: role categories, connected records, and sometimes a nudge toward someone
            credited in a different kind of role. Just follow the names.
          </p>
        </div>
        <div class="contributor-grid">
          <a class="contributor-card" href={`/contributors/${featuredContributor.artist_id}/`}>
            <span class="contributor-card__name">{featuredContributor.name}</span>
            <span class="lede" style="font-size:0.9rem">
              {featuredContributor.role_categories.length} documented role
              {featuredContributor.role_categories.length === 1 ? '' : 's'} · appears on{' '}
              {featuredContributor.albums.length} connected album
              {featuredContributor.albums.length === 1 ? '' : 's'}
            </span>
          </a>
          {featuredNeighbor && (
            <a class="contributor-card" href={`/contributors/${featuredNeighbor.artist_id}/`}>
              <span class="contributor-card__name">
                {featuredNeighbor.name}
                <span class="tag tag--highlight" style="margin-left:6px">Different role</span>
              </span>
              <span class="lede" style="font-size:0.9rem">
                Worth a look from {featuredContributor.name}'s page — credited in a different kind
                of role.
              </span>
            </a>
          )}
        </div>
        <p class="lede" style="margin-top:20px">
          Browse everyone documented in the graph at <a href="/contributors/">/contributors/</a>.
        </p>
      </section>
    )
  }

  <section class="section shell" id="albums" aria-labelledby="albums-title">
    <div class="section-heading">
      <p class="eyebrow">A real connection</p>
      <h2 id="albums-title">{featuredPath.label}</h2>
      <p class="lede">
        {featuredPath.description} This is the first route in the current, versioned challenge
        dataset. Search it yourself, or any other pair, at
        <a href="/play/connect/">Connect Two Records</a>.
      </p>
    </div>
    <div class="album-grid">
      {featuredFrom && <AlbumCard album={featuredFrom} />}
      {featuredTo && <AlbumCard album={featuredTo} />}
    </div>
    {
      behindTheGlassPath && behindTheGlassFrom && behindTheGlassTo && (
        <p class="lede" style="margin-top:24px">
          <em>{behindTheGlassFrom.title}</em> ({behindTheGlassFrom.artist}) and{' '}
          <em>{behindTheGlassTo.title}</em> ({behindTheGlassTo.artist}) connect end to end
          through producer/engineer credits alone — a real{' '}
          <a href="/play/connect/">Behind the Glass</a> route. It's one of three role-restricted
          search modes that look only at a specific kind of credit (producer/engineer,
          drums/bass, or guitar) instead of any documented one.
        </p>
      )
    }
    <p class="lede">
      The full shelf of {albums.length} connected albums lives at <a href="/albums/">/albums/</a>.
    </p>
  </section>

  <section class="section shell" aria-labelledby="how-title">
    <div class="section-heading">
      <p class="eyebrow">{focus.eyebrow}</p>
      <h2 id="how-title">{focus.heading}</h2>
      <p class="lede">{focus.lede}</p>
    </div>
    <div class="feature-grid">
      {
        focus.cards.map((card) => (
          <article class="feature-card" data-tone={card.tone}>
            <span class="kicker">{card.kicker}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section shell" aria-labelledby="state-title">
    <div class="section-heading">
      <p class="eyebrow">What's real here</p>
      <h2 id="state-title">Documented, not inferred.</h2>
      <p class="lede">
        The album grid above and its evidence viewer run on Discogs monthly-dump data (snapshot
        {challenge.provenance.snapshot_date}): {albums.length} studio albums connected by
        {challenge.paths.length} documented credit paths. A role taxonomy for credits, path
        search between any two records, and an open-ended network explorer have all shipped
        since — see <a href="/about/">the full picture</a> for what's live and what's still
        ahead. The connections demo below runs on a separate, smaller dataset: a curated subset
        fetched via the Discogs API, kept from an earlier version of the site before the CC0
        dump pipeline became the primary source.
      </p>
    </div>
    <div class="hero-actions" style="margin-top:0">
      <a class="button primary" href="/demo/">See the connections demo</a>
      <a class="button" href="/about/">Read the full picture</a>
    </div>
  </section>
</BaseLayout>
