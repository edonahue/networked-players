---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AlbumsDirectory from "../../components/AlbumsDirectory.astro";
import type { ChallengeV2 } from "../../data/challenge";
import challengeData from "../../../public/data/challenge.v2.json";
import { connectedCatalogAlbums } from "../../data/connectedAlbums";

const challenge = challengeData as ChallengeV2;
const albums = connectedCatalogAlbums(challenge);

const description =
  "Browse the albums in the current challenge set. Open one to find who connects it to another record, documented credit by credit.";
---

<BaseLayout title="Albums" description={description}>
  <section class="prose shell" style="padding-bottom:8px">
    <p class="eyebrow">Browse</p>
    <h1>Albums</h1>
    <p class="lede">
      Every record here is a door into the credit graph. Open one to find who
      connects it to another album — a shared session player, producer, or
      engineer — then step through the evidence that proves it.
    </p>
  </section>

  <section class="shell" aria-label="Album grid" style="padding-bottom:72px">
    <AlbumsDirectory albums={albums} />
  </section>
</BaseLayout>

<script>
  import { initAlbumsDirectory } from "../../game/albumsDirectory";
  initAlbumsDirectory();
</script>
