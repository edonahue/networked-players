---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidencePanel from '../../components/EvidencePanel.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import RosterPerson from '../../components/RosterPerson.astro';
import AlbumGuessMode from '../../components/AlbumGuessMode.astro';
import { leadsTo, rosterFor, type Membership, type RosterGroup } from '../../data/albumRecord';
import { buildHopViews } from '../../data/evidence';
import type { AlbumV2, ChallengeV2 } from '../../data/challenge';
import { coverFor } from '../../data/albumArt';
import { jsonLdScript, musicAlbumJsonLd } from '../../data/structuredData';
import type { ContributorIndex } from '../../data/contributors';
import challengeData from '../../../public/data/challenge.v3.json';
import membershipData from '../../../public/data/albums/credit-membership.v1.json';
import contributorIndexData from '../../../public/data/contributors/index.v1.json';

const challenge = challengeData as ChallengeV2;
const contributorIndex = contributorIndexData as ContributorIndex;
const contributorIdsWithPages = new Set(
  contributorIndex.contributors.map((c) => c.artist_id),
);
const contributorById = new Map(
  contributorIndex.contributors.map((c) => [c.artist_id, c]),
);

export function getStaticPaths() {
  const data = challengeData as ChallengeV2;
  // Phase 6 PR 6-07: every catalog album gets a real page, not just the
  // ones with a documented challenge.v3 path -- the page body already
  // handles zero connections gracefully ("No documented connections from
  // this album yet."). Narrowing this to path-endpoint albums left 3 real
  // catalog albums (each a real pathfinding-graph node, individually
  // reachable via a live Connect Two Records search) with no page to link
  // to at all -- a genuine dangling-href risk once Connect's own endpoint
  // cards started linking back to /albums/<id>/ in this same PR.
  return data.albums.map((album) => ({
    params: { album: album.id },
    props: { album },
  }));
}

interface Props {
  album: AlbumV2;
}

const { album } = Astro.props;
const { albums, artists, paths, releases } = challenge;
const albumById = new Map(albums.map((a) => [a.id, a]));
// Presentation art from the registry (ADR 0045), never a frozen field.
// album.cover_image is a second fallback for whenever the registry lacks an
// entry -- currently always null across every committed album (the registry
// alone already covers all 140), so this fallback is presently unreachable
// in production. It stays as a real, typed field so a future artifact
// generation can populate it without a page change.
const albumCover = coverFor(album.id) ?? album.cover_image;

const connectedPaths = paths
  .filter((p) => p.from_album_id === album.id || p.to_album_id === album.id)
  .map((path) => {
    const otherAlbumId =
      path.from_album_id === album.id ? path.to_album_id : path.from_album_id;
    return { path, otherAlbum: albumById.get(otherAlbumId) };
  })
  .filter((entry): entry is { path: (typeof paths)[number]; otherAlbum: AlbumV2 } =>
    Boolean(entry.otherAlbum),
  );

// Contributor cards (plan §6/§12.7): the linked identities that carry this
// album's documented connections. Links to each contributor's own page
// (Phase 2 Slice C, ADR 0048) when one exists in the published contributor
// index -- not every linked artist in a path necessarily clears that
// index's own inclusion rule, so this falls back to a plain (non-linked)
// card rather than a dangling href.
const contributorIds = new Set(
  connectedPaths.flatMap(({ path }) =>
    path.hops.flatMap((hop) => [hop.artist_a_id, hop.artist_b_id]),
  ),
);
const contributors = artists.filter((artist) => contributorIds.has(artist.artist_id));

// "Nearby records" (plan §12.7): a real, two-hop, build-time
// join over already-published data -- no new fetch, no new artifact. For
// each of this album's own indexed contributors, look at their
// neighboring_contributor_ids (ADR 0048's own published field), then at
// THOSE neighbors' own albums. A genuinely documented path back to this
// album (shared contributor -> that contributor's documented neighbor ->
// the neighbor's own record), never a similarity claim -- language stays
// "documented through shared contributors," never "similar."
const directlyConnectedAlbumIds = new Set(
  connectedPaths.map(({ otherAlbum }) => otherAlbum.id),
);
const nearbyAlbumIds: string[] = [];
const seenNearbyIds = new Set<string>([album.id, ...directlyConnectedAlbumIds]);
for (const artist of contributors) {
  const indexed = contributorById.get(artist.artist_id);
  if (!indexed) continue;
  for (const neighborId of indexed.neighboring_contributor_ids) {
    const neighbor = contributorById.get(neighborId);
    if (!neighbor) continue;
    for (const nearbyId of neighbor.albums) {
      if (!seenNearbyIds.has(nearbyId)) {
        seenNearbyIds.add(nearbyId);
        nearbyAlbumIds.push(nearbyId);
      }
    }
  }
}
const nearbyAlbums = nearbyAlbumIds
  .map((id) => albumById.get(id))
  .filter((a): a is AlbumV2 => Boolean(a))
  .slice(0, 6);


// --- The album as a record (roster + where these players lead) -----------
const membership = membershipData as unknown as Membership;
const roster = rosterFor(membership, album.id);
const rosterTotal =
  roster.groups.reduce((n, g) => n + g.people.length, 0);
const ROSTER_VISIBLE = 30;
const ALSO_VISIBLE = 12;
const LEADS_VISIBLE = 8;
const SHARED_NAMES = 4;

// Split groups so at most `budget` people render in the page body; the
// remainder sits in a native <details> (no JS), keeping the group headings.
function splitGroups(groups: RosterGroup[], budget: number) {
  const visible: RosterGroup[] = [];
  const rest: RosterGroup[] = [];
  let left = budget;
  for (const group of groups) {
    const shown = group.people.slice(0, Math.max(left, 0));
    const hidden = group.people.slice(shown.length);
    left -= shown.length;
    if (shown.length) visible.push({ ...group, people: shown });
    if (hidden.length) rest.push({ ...group, people: hidden });
  }
  return { visible, rest };
}
const { visible: visibleGroups, rest: restGroups } = splitGroups(roster.groups, ROSTER_VISIBLE);
const alsoVisible = roster.alsoCredited.slice(0, ALSO_VISIBLE);
const alsoRest = roster.alsoCredited.slice(ALSO_VISIBLE);

const leads = leadsTo(membership, album, albums)
  .slice(0, LEADS_VISIBLE)
  .map((lead) => ({ lead, record: albumById.get(lead.albumId) }))
  .filter((e): e is { lead: (typeof e)['lead']; record: AlbumV2 } => Boolean(e.record));

const description = [
  `Who played on ${album.title} by ${album.artist}, the records those players lead to,`,
  'and the credit evidence behind each documented connection.',
].join(' ');
---

<BaseLayout title={album.title} description={description}>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdScript(
      musicAlbumJsonLd(
        album,
        contributorIdsWithPages.has(album.artist_id) ? album.artist_id : undefined,
      ),
    )}
  />
  <section class="shell" style="padding-top:40px">
    <div class="play-header">
      {
        albumCover ? (
          <img
            class="play-header__cover"
            src={albumCover.uri150}
            width="96"
            height="96"
            alt={`Cover art for ${album.title}`}
            data-art-fallback="disc"
          />
        ) : (
          <span class="play-header__placeholder album-card__placeholder" aria-hidden="true">
            <span class="album-card__placeholder-disc" />
          </span>
        )
      }
      <div>
        <p class="eyebrow record-header__eyebrow">Album</p>
        <h1 class="h1-entity">{album.title}</h1>
        <p class="record-header__meta">
          {album.artist}
          {album.year ? ` · ${album.year}` : ''}
        </p>
      </div>
    </div>

    <section class="record-section" aria-labelledby="roster-heading" data-record-roster>
      <h2 id="roster-heading">Who played on this record</h2>
      {
        roster.groups.length === 0 ? (
          <p class="record-section__intro">
            No performers are documented for this record yet.
          </p>
        ) : (
          <>
            <p class="record-section__intro">
              {roster.performerCount} {roster.performerCount === 1 ? 'player' : 'players'} credited
              with a voice or an instrument, in the credits as released. Names link to a player's
              page where one exists.
            </p>
            {visibleGroups.map((group) => (
              <div class="roster-group" data-roster-group={group.key}>
                <h3 class="roster-group__label">{group.label}</h3>
                <ul class="roster-list">
                  {group.people.map((person) => (
                    <RosterPerson person={person} linkable={contributorIdsWithPages} />
                  ))}
                </ul>
              </div>
            ))}
            {restGroups.length > 0 && (
              <details class="record-more">
                <summary>
                  Show all {rosterTotal} players
                </summary>
                {restGroups.map((group) => (
                  <div class="roster-group" data-roster-group={group.key}>
                    <h3 class="roster-group__label">{group.label} (continued)</h3>
                    <ul class="roster-list">
                      {group.people.map((person) => (
                        <RosterPerson person={person} linkable={contributorIdsWithPages} />
                      ))}
                    </ul>
                  </div>
                ))}
              </details>
            )}
          </>
        )
      }

      {
        roster.alsoCredited.length > 0 && (
          <div class="record-also" data-record-also>
            <h3 class="record-also__title">Also credited</h3>
            <p class="record-also__note">
              Writers, producers, engineers and others. These credits are evidence about the
              record, but they do not make a connection.
            </p>
            <ul class="roster-list">
              {alsoVisible.map((person) => (
                <RosterPerson person={person} linkable={contributorIdsWithPages} />
              ))}
            </ul>
            {alsoRest.length > 0 && (
              <details class="record-more">
                <summary>Show all {roster.alsoCredited.length} other credits</summary>
                <ul class="roster-list">
                  {alsoRest.map((person) => (
                    <RosterPerson person={person} linkable={contributorIdsWithPages} />
                  ))}
                </ul>
              </details>
            )}
          </div>
        )
      }
    </section>

    {
      leads.length > 0 && (
        <section class="record-section" aria-labelledby="leads-heading" data-record-leads>
          <h2 id="leads-heading">Where these players lead</h2>
          <p class="record-section__intro">
            Other records in the catalog where some of the same people are credited as performers,
            most shared players first. Records by {album.artist} are left out.
          </p>
          <ul class="leads-list">
            {leads.map(({ lead, record }) => {
              const named = lead.shared.slice(0, SHARED_NAMES);
              const more = lead.shared.length - named.length;
              return (
                <li class="lead" data-lead-album={record.id}>
                  <h3 class="lead__title">
                    <a href={`/albums/${record.id}/`}>{record.title}</a>
                  </h3>
                  <p class="lead__meta">
                    {record.artist}
                    {record.year ? ` · ${record.year}` : ''}
                  </p>
                  <p class="lead__shared">
                    <span class="lead__shared-label">
                      {lead.shared.length === 1 ? 'Shared player: ' : `${lead.shared.length} shared players: `}
                    </span>
                    {named.map((s) => s.name).join(', ')}
                    {more > 0 ? ` and ${more} more` : ''}
                  </p>
                  <p class="lead__actions">
                    <a class="record-link" href={`/play/connect/?a=${album.id}&b=${record.id}`}>
                      Connect these two records →
                    </a>
                  </p>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <section class="record-section" aria-labelledby="connections-heading" data-record-connections>
      <h2 id="connections-heading">Documented connections</h2>
      {
        connectedPaths.length === 0 ? (
          <p class="record-section__intro">
            No documented connection is indexed from {album.title} yet.{' '}
            <a href={`/explore/${album.id}/`}>Explore the players around it</a> instead, or{' '}
            <a href={`/play/connect/?a=${album.id}`}>try connecting it to another record</a>.
          </p>
        ) : (
          <>
            <p class="record-section__intro">
              Each path below runs through people credited as performers on the same recordings. The
              credit evidence is open to read.
            </p>
            <div class="connections-toolbar">
              <button
                type="button"
                class="guess-toggle"
                data-guess-toggle
                aria-pressed="false"
                hidden
              >
                Guess the connections first
              </button>
            </div>
            <ol class="connections-list">
              {connectedPaths.map(({ path, otherAlbum }, index) => {
                const evidenceId = `play-${path.id}-evidence`;
                const otherCover = coverFor(otherAlbum.id) ?? otherAlbum.cover_image;
                return (
                  <li class="connection play-path" data-play-path={path.id} data-connection>
                    <div class="connection__head">
                      <h3 class="connection__title">
                        <span data-guess-title>{otherAlbum.title}</span>
                        <span class="connection__mask" data-guess-mask hidden>
                          Connection {index + 1}: which record?
                        </span>
                      </h3>
                      <button
                        type="button"
                        class="connection__reveal"
                        data-guess-reveal
                        aria-expanded="false"
                        aria-controls={evidenceId + '-body'}
                        hidden
                      >
                        Reveal
                      </button>
                      <a
                        class="record-link"
                        href={`/play/connect/?a=${album.id}&b=${otherAlbum.id}`}
                      >
                        Search this route in Connect Two Records →
                      </a>
                    </div>
                    <details class="connection__body" id={evidenceId + '-body'} open={index === 0} data-guess-body>
                      <summary>Credit evidence · {path.description}</summary>
                      <EvidencePanel
                        class="evidence-card"
                        id={evidenceId}
                        pathId={path.id}
                        hops={buildHopViews(path.hops, releases, artists)}
                      >
                        <div class="evidence-card__summary">
                          <div class="evidence-card__endpoint">
                            {albumCover && (
                              <img
                                class="cover-thumb"
                                src={albumCover.uri150}
                                width="56"
                                height="56"
                                loading="lazy"
                                alt=""
                                data-art-fallback="hide"
                              />
                            )}
                            <span>{album.title}</span>
                          </div>
                          <span class="arrow" aria-hidden="true">→</span>
                          <div class="evidence-card__endpoint">
                            {otherCover && (
                              <img
                                class="cover-thumb"
                                src={otherCover.uri150}
                                width="56"
                                height="56"
                                loading="lazy"
                                alt=""
                                data-art-fallback="hide"
                              />
                            )}
                            <span>{otherAlbum.title}</span>
                          </div>
                        </div>
                      </EvidencePanel>
                    </details>
                  </li>
                );
              })}
            </ol>
          </>
        )
      }
    </section>

    {
      nearbyAlbums.length > 0 && (
        <section class="record-section" aria-label="Nearby records">
          <h2 class="record-section__title">Nearby records</h2>
          <p class="record-section__intro">
            Connected through players they share with this record. The credits link them; they say nothing
            about how they sound.
          </p>
          <div class="album-grid">
            {nearbyAlbums.map((nearbyAlbum) => <AlbumCard album={nearbyAlbum} />)}
          </div>
        </section>
      )
    }

    <section aria-label="Play from here" class="play-from-here">
      <p class="lede" style="font-size:0.98rem">
        Prefer to guess before you look? The{' '}
        <a href="/play/connection/">Connection Guesser</a> deals rounds like these —
        two records, one credited name to find — and the{' '}
        <a href="/play/daily/">Connection of the Day</a> deals one for everyone.
      </p>
      <p class="lede" style="font-size:0.98rem">
        See how {album.title} connects to everything else in the{' '}
        <a href={`/explore/${album.id}/`}>Network Explorer</a>, centered on {album.artist} — or{' '}
        <a href={`/play/connect/?a=${album.id}`}>try connecting it to another record</a> yourself.
      </p>
    </section>
  </section>
</BaseLayout>

<AlbumGuessMode />
