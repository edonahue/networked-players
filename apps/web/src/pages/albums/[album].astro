---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidencePanel from '../../components/EvidencePanel.astro';
import RevealControls from '../../components/RevealControls.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { buildHopViews } from '../../data/evidence';
import type { AlbumV2, ChallengeV2 } from '../../data/challenge';
import { coverFor } from '../../data/albumArt';
import type { ContributorIndex } from '../../data/contributors';
import challengeData from '../../../public/data/challenge.v3.json';
import contributorIndexData from '../../../public/data/contributors/index.v1.json';

const challenge = challengeData as ChallengeV2;
const contributorIndex = contributorIndexData as ContributorIndex;
const contributorIdsWithPages = new Set(
  contributorIndex.contributors.map((c) => c.artist_id),
);
const contributorById = new Map(
  contributorIndex.contributors.map((c) => [c.artist_id, c]),
);

export function getStaticPaths() {
  const data = challengeData as ChallengeV2;
  // Phase 6 PR 6-07: every catalog album gets a real page, not just the
  // ones with a documented challenge.v3 path -- the page body already
  // handles zero connections gracefully ("No documented connections from
  // this album yet."). Narrowing this to path-endpoint albums left 3 real
  // catalog albums (each a real pathfinding-graph node, individually
  // reachable via a live Connect Two Records search) with no page to link
  // to at all -- a genuine dangling-href risk once Connect's own endpoint
  // cards started linking back to /albums/<id>/ in this same PR.
  return data.albums.map((album) => ({
    params: { album: album.id },
    props: { album },
  }));
}

interface Props {
  album: AlbumV2;
}

const { album } = Astro.props;
const { albums, artists, paths, releases } = challenge;
const albumById = new Map(albums.map((a) => [a.id, a]));
// Presentation art from the registry (ADR 0045), never a frozen field.
// album.cover_image is a second fallback for whenever the registry lacks an
// entry -- currently always null across every committed album (the registry
// alone already covers all 140), so this fallback is presently unreachable
// in production. It stays as a real, typed field so a future artifact
// generation can populate it without a page change.
const albumCover = coverFor(album.id) ?? album.cover_image;

const connectedPaths = paths
  .filter((p) => p.from_album_id === album.id || p.to_album_id === album.id)
  .map((path) => {
    const otherAlbumId =
      path.from_album_id === album.id ? path.to_album_id : path.from_album_id;
    return { path, otherAlbum: albumById.get(otherAlbumId) };
  })
  .filter((entry): entry is { path: (typeof paths)[number]; otherAlbum: AlbumV2 } =>
    Boolean(entry.otherAlbum),
  );

// Contributor cards (plan §6/§12.7): the linked identities that carry this
// album's documented connections. Links to each contributor's own page
// (Phase 2 Slice C, ADR 0048) when one exists in the published contributor
// index -- not every linked artist in a path necessarily clears that
// index's own inclusion rule, so this falls back to a plain (non-linked)
// card rather than a dangling href.
const contributorIds = new Set(
  connectedPaths.flatMap(({ path }) =>
    path.hops.flatMap((hop) => [hop.artist_a_id, hop.artist_b_id]),
  ),
);
const contributors = artists.filter((artist) => contributorIds.has(artist.artist_id));

// "Nearby in the credit network" (plan §12.7): a real, two-hop, build-time
// join over already-published data -- no new fetch, no new artifact. For
// each of this album's own indexed contributors, look at their
// neighboring_contributor_ids (ADR 0048's own published field), then at
// THOSE neighbors' own albums. A genuinely documented path back to this
// album (shared contributor -> that contributor's documented neighbor ->
// the neighbor's own record), never a similarity claim -- language stays
// "documented through shared contributors," never "similar."
const directlyConnectedAlbumIds = new Set(
  connectedPaths.map(({ otherAlbum }) => otherAlbum.id),
);
const nearbyAlbumIds: string[] = [];
const seenNearbyIds = new Set<string>([album.id, ...directlyConnectedAlbumIds]);
for (const artist of contributors) {
  const indexed = contributorById.get(artist.artist_id);
  if (!indexed) continue;
  for (const neighborId of indexed.neighboring_contributor_ids) {
    const neighbor = contributorById.get(neighborId);
    if (!neighbor) continue;
    for (const nearbyId of neighbor.albums) {
      if (!seenNearbyIds.has(nearbyId)) {
        seenNearbyIds.add(nearbyId);
        nearbyAlbumIds.push(nearbyId);
      }
    }
  }
}
const nearbyAlbums = nearbyAlbumIds
  .map((id) => albumById.get(id))
  .filter((a): a is AlbumV2 => Boolean(a))
  .slice(0, 6);

const description = [
  `Find the documented connections between ${album.title}`,
  'and other albums, with credit evidence at every hop.',
].join(' ');
---

<BaseLayout title={album.title} description={description}>
  <section class="shell" style="padding-top:40px">
    <div class="play-header">
      {
        albumCover ? (
          <img
            class="play-header__cover"
            src={albumCover.uri150}
            width="96"
            height="96"
            alt={`Cover art for ${album.title}`}
            data-art-fallback="disc"
          />
        ) : (
          <span class="play-header__placeholder album-card__placeholder" aria-hidden="true">
            <span class="album-card__placeholder-disc" />
          </span>
        )
      }
      <div>
        <p class="eyebrow" style="margin-bottom:6px">Album</p>
        <h1 class="h1-entity">{album.title}</h1>
        <p class="lede" style="margin-top:6px;font-size:1rem">
          {album.artist}
          {album.year ? ` · ${album.year}` : ''}
        </p>
      </div>
    </div>

    {
      connectedPaths.length === 0 ? (
        <p class="lede">
          No documented connection is indexed from {album.title} yet.{' '}
          <a href={`/explore/${album.id}/`}>Explore its documented credit network</a> instead, or{' '}
          <a href={`/play/connect/?a=${album.id}`}>try connecting it to another record</a>.
        </p>
      ) : (
        <>
          <div class="mode-toggle" role="group" aria-label="Play mode">
            <button type="button" data-reveal-mode="hide" aria-pressed="true">
              Find the connection
            </button>
            <button type="button" data-reveal-mode="show" aria-pressed="false">
              Reveal every path
            </button>
          </div>

          {
            connectedPaths.map(({ path, otherAlbum }, index) => {
              const evidenceId = `play-${path.id}-evidence`;
              return (
                <div
                  class="play-path"
                  data-play-path={path.id}
                  data-reveal-scope
                  style="margin-bottom:20px"
                >
                  <p class="path-card__sub" style="margin-bottom:12px">
                    Connection {index + 1}:{' '}
                    <span class="guess-target" data-guess-target data-revealed="false">
                      {otherAlbum.title}
                    </span>{' '}
                    <button
                      type="button"
                      data-reveal-button
                      data-reveal-label="Reveal"
                      data-hide-label="Hide"
                      aria-expanded="false"
                      aria-controls={evidenceId}
                    >
                      Reveal
                    </button>{' '}
                    <a href={`/play/connect/?a=${album.id}&b=${otherAlbum.id}`}>
                      Search this route in Connect Two Records →
                    </a>
                  </p>
                  <EvidencePanel
                    class="evidence-card"
                    id={evidenceId}
                    pathId={path.id}
                    hops={buildHopViews(path.hops, releases, artists)}
                    hidden
                  >
                    <div class="evidence-card__summary">
                      <div class="evidence-card__endpoint">
                        {albumCover && (
                          <img
                            class="cover-thumb"
                            src={albumCover.uri150}
                            width="56"
                            height="56"
                            loading="lazy"
                            alt=""
                            data-art-fallback="hide"
                          />
                        )}
                        <span>{album.title}</span>
                      </div>
                      <span class="arrow" aria-hidden="true">→</span>
                      <div class="evidence-card__endpoint">
                        {(coverFor(otherAlbum.id) ?? otherAlbum.cover_image) && (
                          <img
                            class="cover-thumb"
                            src={(coverFor(otherAlbum.id) ?? otherAlbum.cover_image)!.uri150}
                            width="56"
                            height="56"
                            loading="lazy"
                            alt=""
                            data-art-fallback="hide"
                          />
                        )}
                        <span>{otherAlbum.title}</span>
                      </div>
                    </div>
                    <p class="path-card__sub">{path.description}</p>
                  </EvidencePanel>
                </div>
              );
            })
          }

          {
            contributors.length > 0 && (
              <section aria-label="Linked contributors" style="margin-top:28px">
                <p class="eyebrow" style="margin-bottom:10px">
                  Contributors in these connections
                </p>
                <div class="contributor-grid">
                  {
                    contributors.map((artist) =>
                      contributorIdsWithPages.has(artist.artist_id) ? (
                        <a
                          class="contributor-card"
                          href={`/contributors/${artist.artist_id}/`}
                        >
                          <span class="contributor-card__name">{artist.name}</span>
                          <span class="contributor-card__id">
                            #{artist.artist_id} · linked identity
                          </span>
                        </a>
                      ) : (
                        <div class="contributor-card" title="Not yet in the published contributor index -- credited here, but without its own page yet">
                          <span class="contributor-card__name">{artist.name}</span>
                          <span class="contributor-card__id">
                            #{artist.artist_id} · not yet indexed
                          </span>
                        </div>
                      ),
                    )
                  }
                </div>
              </section>
            )
          }

          {
            nearbyAlbums.length > 0 && (
              <section aria-label="Nearby records" style="margin-top:28px">
                <p class="eyebrow" style="margin-bottom:10px">
                  Nearby in the credit network
                </p>
                <p class="lede" style="margin-bottom:14px;font-size:0.92rem">
                  Connected through shared contributors. The credit graph links them; it says
                  nothing about how they sound.
                </p>
                <div class="album-grid">
                  {nearbyAlbums.map((nearbyAlbum) => <AlbumCard album={nearbyAlbum} />)}
                </div>
              </section>
            )
          }
        </>
      )
    }

    <section aria-label="Play from here" class="play-from-here">
      <p class="lede" style="font-size:0.98rem">
        Prefer to guess before you look? The{' '}
        <a href="/play/connection/">Connection Guesser</a> deals rounds like these —
        two records, one credited name to find — and the{' '}
        <a href="/play/daily/">Connection of the Day</a> deals one for everyone.
      </p>
      <p class="lede" style="font-size:0.98rem">
        See how {album.title} connects to everything else in the{' '}
        <a href={`/explore/${album.id}/`}>Network Explorer</a>, centered on {album.artist} — or{' '}
        <a href={`/play/connect/?a=${album.id}`}>try connecting it to another record</a> yourself.
      </p>
    </section>
  </section>
</BaseLayout>

<RevealControls />
