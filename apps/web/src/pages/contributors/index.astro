---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContributorsDirectory from '../../components/ContributorsDirectory.astro';

// Contributors directory (ADR 0058 Slice 8): search, role-category filter
// chips, and a most-connected list over the public contributor index --
// zero new backend, reusing the index's already-public connection_count
// field. Not attempting a betweenness-based "bridge contributors" list
// here; that needs the private one-hop corpus, not this published index.
// "every contributor in the credit graph" was false by a factor of ~37: the
// index covers only people on a documented path or route (639 of ~23,361
// performers in graph.v4), because it is built from challenge.v3.json,
// routes/{universe,rounds}.v1.json and the evidence registry -- never the
// full graph. Contributor pages are derived views that legitimately come and
// go (ADR 0048's 2026-09-05 addendum), so the copy must not imply exhaustive
// coverage of the graph.
const description =
  'Search and filter the contributors behind Networked Players’ documented connections, or browse the most connected.';
---

<BaseLayout title="Contributors" description={description}>
  <section class="prose shell" style="padding-bottom:0">
    <p class="eyebrow">Contributors</p>
    <h1 class="h1-intro">
      The people behind the documented connections.
    </h1>
    <p class="lede">
      Every name here is credited on at least one release in the catalog.
    </p>
  </section>

  <section class="shell" style="padding-top:28px;padding-bottom:72px">
    <ContributorsDirectory />
  </section>
</BaseLayout>

<script>
  import { initContributorsDirectory } from '../../game/contributorsDirectory';
  initContributorsDirectory();
</script>
