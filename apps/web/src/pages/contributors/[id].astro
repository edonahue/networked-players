---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import EvidencePanel from '../../components/EvidencePanel.astro';
import { buildHopViews } from '../../data/evidence';
import type { Contributor, ContributorIndex } from '../../data/contributors';
import { playedPhrase, playerRoles } from '../../data/playerRecord';
import { albumHopDistancesByArtist, type AlbumHopDistances } from '../../data/albumHopDistances';
import { coverFor } from '../../data/albumArt';
import { jsonLdScript, personJsonLd } from '../../data/structuredData';
import type { AlbumV2, ChallengeV2 } from '../../data/challenge';
import type { RoutesRounds } from '../../game/routesTypes';
import contributorIndexData from '../../../public/data/contributors/index.v1.json';
import albumHopDistancesData from '../../../public/data/contributors/album-hop-distances.v1.json';
import challengeData from '../../../public/data/challenge.v3.json';
import routesRoundsData from '../../../public/data/routes/rounds.v1.json';

const contributorIndex = contributorIndexData as ContributorIndex;
const albumHopDistances = albumHopDistancesData as AlbumHopDistances;
const challenge = challengeData as ChallengeV2;
const routesRounds = routesRoundsData as RoutesRounds;
const hopDistancesByArtist = albumHopDistancesByArtist(albumHopDistances);

export function getStaticPaths() {
  const index = contributorIndexData as ContributorIndex;
  return index.contributors.map((contributor) => ({
    params: { id: String(contributor.artist_id) },
    props: { contributor },
  }));
}

interface Props {
  contributor: Contributor;
}

const { contributor } = Astro.props;

const albumById = new Map(challenge.albums.map((a) => [a.id, a]));
const albums = contributor.albums
  .map((id) => albumById.get(id))
  .filter((a): a is AlbumV2 => Boolean(a));
// The companion album-hop-distances artifact (ADR 0048 addendum) carries
// the same album-id set as `albums` above, enriched with hop_distance and
// already sorted by (hop_distance, album_id) within this artist's own
// entries -- no extra sort needed here, same convention
// neighboring_contributor_ids uses. ADR 0068 retired the background-only
// muting that used to reorder ties within a hop_distance: every album
// listed here is now reached through a documented performer hop, so there
// is no "technical-credit-only" subset left to de-emphasize.
const albumEntries = (hopDistancesByArtist.get(contributor.artist_id) ?? [])
  .map((entry) => {
    const album = albumById.get(entry.album_id);
    return album ? { album, hopDistance: entry.hop_distance } : null;
  })
  .filter((e): e is { album: AlbumV2; hopDistance: number } => Boolean(e));

const contributorById = new Map(
  contributorIndex.contributors.map((c) => [c.artist_id, c]),
);
const neighbors = contributor.neighboring_contributor_ids
  .map((id) => contributorById.get(id))
  .filter((c): c is Contributor => Boolean(c));

// ADR 0060: a single highlighted neighbor, never a replacement for the full
// list above -- every neighbor stays visible either way. Resolved through
// the same contributorById lookup as the list itself, so a next-step id
// that somehow doesn't resolve to a real, currently-listed neighbor simply
// renders nothing extra, never a dangling reference.
const interestingNextStep = contributor.interesting_next_step;
const interestingNeighbor = interestingNextStep
  ? contributorById.get(interestingNextStep.artist_id)
  : undefined;

// Every documented hop this contributor is party to, from both real-data
// sources this index is built from -- the same evidence component every
// other surface (album pages, the demo, cohorts) already renders through.
// Deduplicated by (release, artist pair): the SAME documented hop is
// reused across many paths/rounds, and rendering it once per path showed
// the identical evidence card several times over. Real, measured on the
// committed artifacts: Brian Eno's 24 challenge hops are only 11 distinct
// hops, and the worst contributor's 170 collapse to 39 -- so the page was
// rendering up to 131 duplicate cards. That is noise, not more evidence
// (the same credit doesn't become better-attested by being listed again),
// and the resulting DOM was heavy enough to time out this page's own axe
// scan. Pre-existing, not introduced by the ADR 0068 cutover -- v2's own
// worst case was 172 hops -> 62 distinct -- but the cutover changed WHICH
// contributors are affected, which is how it surfaced.
function dedupeHops<T extends { release_id: number; artist_a_id: number; artist_b_id: number }>(
  hops: T[],
): T[] {
  const seen = new Set<string>();
  return hops.filter((hop) => {
    const key = `${hop.release_id}|${hop.artist_a_id}|${hop.artist_b_id}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

const challengeHops = dedupeHops(
  challenge.paths
    .flatMap((path) => path.hops)
    .filter(
      (hop) =>
        hop.artist_a_id === contributor.artist_id || hop.artist_b_id === contributor.artist_id,
    ),
);
const routeHops = dedupeHops(
  routesRounds.rounds
    .flatMap((round) => round.hops)
    .filter(
      (hop) =>
        hop.artist_a_id === contributor.artist_id || hop.artist_b_id === contributor.artist_id,
    ),
);

const evidenceHops = [
  ...buildHopViews(challengeHops, challenge.releases, challenge.artists),
  ...buildHopViews(routeHops, routesRounds.releases, routesRounds.artists),
];

// A real visual anchor when one exists -- the contributor's own first
// connected album's cover (ADR 0045 registry), never an invented image.
// Falls back to the same vinyl-disc placeholder album pages already use
// (`play-header__placeholder`/`album-card__placeholder`), so a contributor
// with no registry-covered album still gets the same honest treatment an
// album with no cover gets, not a blank header.
const contributorCover = albums.length > 0 ? coverFor(albums[0].id) : null;

// What this person is documented PLAYING, from the role text in the indexed
// evidence (data/playerRecord.ts). Producer/engineer/writer credits are kept
// apart as "Also credited" and never described as playing.
const roles = playerRoles(contributor);
const playedText = playedPhrase(roles.played);
const ALSO_VISIBLE = 8;
const alsoVisible = roles.also.slice(0, ALSO_VISIBLE);
const alsoRest = roles.also.slice(ALSO_VISIBLE);

// "Connect records through this player": only offered when there are
// genuinely two distinct connected albums to prefill Connect Two Records
// with -- never a single-album or self-paired link.
const connectAlbumA = albums[0];
const connectAlbumB = albums.length > 1 ? albums[1] : undefined;

// A concrete "why" for the ADR 0060 nudge, in the same terms as the header:
// what the neighbor is documented playing.
const interestingNeighborPlayed = interestingNeighbor
  ? playedPhrase(playerRoles(interestingNeighbor).played)
  : null;

const recordCount = albums.length;
const description = playedText
  ? `${contributor.name} is documented playing ${playedText}${
      recordCount > 0
        ? `, with documented connections reaching ${recordCount} ${recordCount === 1 ? 'record' : 'records'} in the Networked Players catalog`
        : ''
    }, the players they recur with, and the credits behind each connection.`
  : `${contributor.name} is credited in the Networked Players catalog${
      recordCount > 0
        ? ` on releases connecting ${recordCount} ${recordCount === 1 ? 'record' : 'records'}`
        : ''
    }. No voice or instrument credit is indexed for them, so they make no connection here; their credits are listed as evidence.`;
---

<BaseLayout title={contributor.name} description={description}>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdScript(personJsonLd(contributor.artist_id, contributor.name))}
  />
  <section class="shell" style="padding-top:40px">
    <div class="play-header">
      {
        contributorCover ? (
          <img
            class="play-header__cover"
            src={contributorCover.uri150}
            width="96"
            height="96"
            alt=""
            loading="lazy"
            data-art-fallback="disc"
          />
        ) : (
          <span class="play-header__placeholder album-card__placeholder" aria-hidden="true">
            <span class="album-card__placeholder-disc" />
          </span>
        )
      }
      <div>
        <p class="eyebrow record-header__eyebrow">
          <a href="/contributors/">Players</a>
        </p>
        <h1 class="h1-entity" data-artist-id={contributor.artist_id}>{contributor.name}</h1>
        <p class="record-header__meta" data-player-summary>
          {
            playedText
              ? `Documented playing ${playedText}.`
              : 'No voice or instrument credit is indexed for this person yet.'
          }
        </p>
      </div>
    </div>

    {
      albums.length > 0 ? (
        <p class="lede" style="max-width:720px;font-size:0.98rem">
          <a href={`/explore/${albums[0].id}/?center=${contributor.artist_id}`}>
            Explore around {contributor.name}
          </a>{' '}
          to see who they played with.
          {connectAlbumB && (
            <>
              {' '}Or{' '}
              <a href={`/play/connect/?a=${connectAlbumA.id}&b=${connectAlbumB.id}`}>
                connect two of their records
              </a>{' '}
              directly.
            </>
          )}
        </p>
      ) : (
        <p class="lede" style="max-width:720px;font-size:0.98rem">
          No record is connected to {contributor.name} yet. Browse{' '}
          <a href="/contributors/">other players</a> instead.
        </p>
      )
    }

    {
      albumEntries.length > 0 && (
        <section class="record-section" aria-labelledby="records-heading" data-player-records>
          <h2 id="records-heading">Records their connections reach</h2>
          <p class="lede">
            Records their documented connections lead to. A record marked with a distance is that
            many connections away, not one they played on.
          </p>
          <div class="album-grid">
            {
              albumEntries.map(({ album, hopDistance }) => (
                <AlbumCard
                  album={album}
                  note={
                    hopDistance > 0
                      ? `${hopDistance} documented hop${hopDistance === 1 ? '' : 's'} away`
                      : undefined
                  }
                />
              ))
            }
          </div>
        </section>
      )
    }

    {
      neighbors.length > 0 ? (
        <section class="record-section" aria-labelledby="recur-heading" data-player-recurs>
          <h2 id="recur-heading">Players they recur with</h2>
          <p class="record-section__intro">
            Other players documented on the same recordings.
          </p>
          {
            interestingNeighbor && (
              <p class="lede" style="margin-bottom:14px;font-size:0.92rem">
                Worth a look:{' '}
                <a href={`/contributors/${interestingNeighbor.artist_id}/`}>
                  {interestingNeighbor.name}
                </a>
                {interestingNeighborPlayed
                  ? `, documented playing ${interestingNeighborPlayed}${playedText ? `, where ${contributor.name} is documented on ${playedText}` : ''}.`
                  : ', who took a different part on these records.'}
              </p>
            )
          }
          <div class="contributor-grid">
            {neighbors.map((neighbor) => {
              const theirs = playedPhrase(playerRoles(neighbor).played);
              return (
                <a class="contributor-card" href={`/contributors/${neighbor.artist_id}/`}>
                  <span class="contributor-card__name">
                    {neighbor.name}
                    {interestingNeighbor && neighbor.artist_id === interestingNeighbor.artist_id && (
                      <span class="tag tag--highlight" style="margin-left:6px">
                        Different part
                      </span>
                    )}
                  </span>
                  {theirs && <span class="contributor-card__id">{theirs}</span>}
                </a>
              );
            })}
          </div>
        </section>
      ) : (
        <p class="lede" style="max-width:720px;margin-top:28px;font-size:0.95rem">
          No other player is indexed alongside {contributor.name} on a documented recording yet.{' '}
          <a href="/contributors/">Browse all players</a> to find someone to follow.
        </p>
      )
    }

    {
      roles.also.length > 0 && (
        <div class="record-also" data-player-also>
          <h2 class="record-also__title">Also credited</h2>
          <p class="record-also__note">
            {contributor.name} is also credited for these. They appear in the credits but do not
            make a connection.
          </p>
          <p class="lede" style="font-size:0.95rem" data-player-also-list>
            {alsoVisible.join(', ')}
          </p>
          {alsoRest.length > 0 && (
            <details class="record-more">
              <summary>Show {alsoRest.length} more</summary>
              <p class="lede" style="font-size:0.95rem">{alsoRest.join(', ')}</p>
            </details>
          )}
        </div>
      )
    }

    {
      evidenceHops.length > 0 && (
        <section class="record-section" aria-labelledby="evidence-heading">
          <h2 id="evidence-heading">Documented evidence</h2>
          <EvidencePanel class="evidence-card" hops={evidenceHops} />
        </section>
      )
    }
  </section>
</BaseLayout>
