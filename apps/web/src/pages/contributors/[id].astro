---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import EvidencePanel from '../../components/EvidencePanel.astro';
import { buildHopViews } from '../../data/evidence';
import { ROLE_CATEGORY_LABEL, type Contributor, type ContributorIndex } from '../../data/contributors';
import { albumHopDistancesByArtist, type AlbumHopDistances } from '../../data/albumHopDistances';
import { isBackgroundOnlyRoleProfile } from '../../game/roleTaxonomy';
import { coverFor } from '../../data/albumArt';
import type { AlbumV2, ChallengeV2 } from '../../data/challenge';
import type { RoutesRounds } from '../../game/routesTypes';
import contributorIndexData from '../../../public/data/contributors/index.v1.json';
import albumHopDistancesData from '../../../public/data/contributors/album-hop-distances.v1.json';
import challengeData from '../../../public/data/challenge.v2.json';
import routesRoundsData from '../../../public/data/routes/rounds.v1.json';

const contributorIndex = contributorIndexData as ContributorIndex;
const albumHopDistances = albumHopDistancesData as AlbumHopDistances;
const challenge = challengeData as ChallengeV2;
const routesRounds = routesRoundsData as RoutesRounds;
const hopDistancesByArtist = albumHopDistancesByArtist(albumHopDistances);

export function getStaticPaths() {
  const index = contributorIndexData as ContributorIndex;
  return index.contributors.map((contributor) => ({
    params: { id: String(contributor.artist_id) },
    props: { contributor },
  }));
}

interface Props {
  contributor: Contributor;
}

const { contributor } = Astro.props;

const albumById = new Map(challenge.albums.map((a) => [a.id, a]));
const albums = contributor.albums
  .map((id) => albumById.get(id))
  .filter((a): a is AlbumV2 => Boolean(a));
// True when this contributor's MOST FREQUENT credit (role_text_examples,
// "Primarily credited for" above) is Mastered By/Recorded By/Mixed By AND
// their full role_categories carries no substantive (non-background)
// category -- de-emphasizes their non-direct (hop_distance > 0) album
// connections below without hiding them, the same visual language
// Explore's isDimmed() already uses. hop_distance 0 entries are always
// this contributor's own record, never muted. The role_categories check
// matters: a contributor whose most frequent credit is background-
// engineering can still carry a real, substantive connection elsewhere
// (e.g. a singer who also mixed a handful of releases) -- see
// isBackgroundOnlyRoleProfile's own doc comment for the real committed
// data (Julio Iglesias, artist 67331) that caught this in review.
const isBackgroundOnlyContributor = isBackgroundOnlyRoleProfile(
  contributor.role_text_examples,
  contributor.role_categories,
);
// The companion album-hop-distances artifact (ADR 0048 addendum) carries
// the same album-id set as `albums` above, enriched with hop_distance and
// already sorted by (hop_distance, album_id) within this artist's own
// entries -- no extra sort needed here, same convention
// neighboring_contributor_ids uses.
const albumEntries = (hopDistancesByArtist.get(contributor.artist_id) ?? [])
  .map((entry) => {
    const album = albumById.get(entry.album_id);
    return album
      ? {
          album,
          hopDistance: entry.hop_distance,
          muted: entry.hop_distance > 0 && isBackgroundOnlyContributor,
        }
      : null;
  })
  .filter(
    (e): e is { album: AlbumV2; hopDistance: number; muted: boolean } =>
      Boolean(e),
  )
  // Muted entries sort after their non-muted same-hop_distance peers --
  // the artifact's own (hop_distance, album_id) order is otherwise
  // preserved (a stable sort only reorders ties on the new muted key).
  .sort((a, b) => {
    if (a.hopDistance !== b.hopDistance) return a.hopDistance - b.hopDistance;
    return Number(a.muted) - Number(b.muted);
  });

const contributorById = new Map(
  contributorIndex.contributors.map((c) => [c.artist_id, c]),
);
const neighbors = contributor.neighboring_contributor_ids
  .map((id) => contributorById.get(id))
  .filter((c): c is Contributor => Boolean(c));

// ADR 0060: a single highlighted neighbor, never a replacement for the full
// list above -- every neighbor stays visible either way. Resolved through
// the same contributorById lookup as the list itself, so a next-step id
// that somehow doesn't resolve to a real, currently-listed neighbor simply
// renders nothing extra, never a dangling reference.
const interestingNextStep = contributor.interesting_next_step;
const interestingNeighbor = interestingNextStep
  ? contributorById.get(interestingNextStep.artist_id)
  : undefined;

// Every documented hop this contributor is party to, from both real-data
// sources this index is built from -- the same evidence component every
// other surface (album pages, the demo, cohorts) already renders through.
const challengeHops = challenge.paths
  .flatMap((path) => path.hops)
  .filter(
    (hop) =>
      hop.artist_a_id === contributor.artist_id || hop.artist_b_id === contributor.artist_id,
  );
const routeHops = routesRounds.rounds
  .flatMap((round) => round.hops)
  .filter(
    (hop) =>
      hop.artist_a_id === contributor.artist_id || hop.artist_b_id === contributor.artist_id,
  );

const evidenceHops = [
  ...buildHopViews(challengeHops, challenge.releases, challenge.artists),
  ...buildHopViews(routeHops, routesRounds.releases, routesRounds.artists),
];

// A real visual anchor when one exists -- the contributor's own first
// connected album's cover (ADR 0045 registry), never an invented image.
// Falls back to the same vinyl-disc placeholder album pages already use
// (`play-header__placeholder`/`album-card__placeholder`), so a contributor
// with no registry-covered album still gets the same honest treatment an
// album with no cover gets, not a blank header.
const contributorCover = albums.length > 0 ? coverFor(albums[0].id) : null;

// A one-line human summary of role_categories, alongside (not instead of)
// the tag chips below -- "Primarily credited for: X, Y" rather than
// requiring a visitor to parse a row of tags on their own.
const roleSummary = contributor.role_categories
  .map((category) => ROLE_CATEGORY_LABEL[category] ?? category)
  .join(', ');

// "Connect records through this contributor": only offered when there are
// genuinely two distinct connected albums to prefill Connect Two Records
// with -- never a single-album or self-paired link.
const connectAlbumA = albums[0];
const connectAlbumB = albums.length > 1 ? albums[1] : undefined;

// A concrete "why" for the ADR 0060 nudge, not just "a different kind of
// role" -- interestingNeighbor's own role_categories are guaranteed
// disjoint from contributor's own (that's the field's own selection rule),
// so naming them directly is always accurate, never inferred.
const interestingNeighborRoleSummary = interestingNeighbor
  ? interestingNeighbor.role_categories
      .map((category) => ROLE_CATEGORY_LABEL[category] ?? category)
      .join(', ')
  : null;

const description = `Documented credits and connections for ${contributor.name} in the Networked Players credit graph.`;
---

<BaseLayout title={contributor.name} description={description}>
  <section class="shell" style="padding-top:40px">
    <div class="play-header">
      {
        contributorCover ? (
          <img
            class="play-header__cover"
            src={contributorCover.uri150}
            width="96"
            height="96"
            alt=""
            loading="lazy"
            data-art-fallback="disc"
          />
        ) : (
          <span class="play-header__placeholder album-card__placeholder" aria-hidden="true">
            <span class="album-card__placeholder-disc" />
          </span>
        )
      }
      <div>
        <p class="eyebrow" style="margin-bottom:6px">
          <a href="/contributors/">Contributors</a>
        </p>
        <h1 class="h1-entity">{contributor.name}</h1>
        <p class="lede" style="margin-top:6px;font-size:1rem">
          #{contributor.artist_id} · linked identity
        </p>
        {
          roleSummary && (
            <p class="lede" style="margin-top:6px;font-size:0.95rem">
              Primarily credited for: {roleSummary}
            </p>
          )
        }
        <div class="contributor-grid" style="margin-top:14px;gap:8px">
          {
            contributor.role_categories.map((category) => (
              <span class="tag tag--linked">
                {ROLE_CATEGORY_LABEL[category] ?? category}
              </span>
            ))
          }
        </div>
        {
          contributor.role_text_examples.length > 0 && (
            <p class="lede" style="margin-top:10px;font-size:0.92rem">
              Credited as: {contributor.role_text_examples.join(', ')}
            </p>
          )
        }
        {
          contributor.decade_activity.length > 0 && (
            <p class="lede" style="margin-top:6px;font-size:0.92rem">
              Active decades in this dataset: {contributor.decade_activity.map((d) => `${d}s`).join(', ')}
            </p>
          )
        }
      </div>
    </div>

    <p class="lede" style="max-width:720px">
      {contributor.name} is co-credited on the releases connecting the albums below.
    </p>

    {
      albums.length > 0 ? (
        <p class="lede" style="max-width:720px;font-size:0.98rem">
          <a href={`/explore/${albums[0].id}/?center=${contributor.artist_id}`}>
            Explore {contributor.name}'s documented credit neighborhood
          </a>{' '}
          in the Network Explorer.
          {connectAlbumB && (
            <>
              {' '}Or{' '}
              <a href={`/play/connect/?a=${connectAlbumA.id}&b=${connectAlbumB.id}`}>
                connect two of their records
              </a>{' '}
              directly.
            </>
          )}
        </p>
      ) : (
        <p class="lede" style="max-width:720px;font-size:0.98rem">
          No documented album connection is indexed for {contributor.name} yet. Browse{' '}
          <a href="/contributors/">everyone else in the graph</a> instead.
        </p>
      )
    }

    {
      albumEntries.length > 0 && (
        <section aria-label="Connected albums" style="margin-top:28px">
          <p class="eyebrow" style="margin-bottom:10px">
            Albums connected through this contributor's documented credits
          </p>
          <div class="album-grid">
            {
              albumEntries.map(({ album, hopDistance, muted }) => (
                <AlbumCard
                  album={album}
                  note={
                    hopDistance > 0
                      ? `${hopDistance} documented hop${hopDistance === 1 ? "" : "s"} away`
                      : undefined
                  }
                  muted={muted}
                />
              ))
            }
          </div>
        </section>
      )
    }

    {
      neighbors.length > 0 ? (
        <section aria-label="Neighboring contributors" style="margin-top:28px">
          <p class="eyebrow" style="margin-bottom:10px">
            Other contributors co-credited on the same documented releases
          </p>
          {
            interestingNeighbor && interestingNeighborRoleSummary && (
              <p class="lede" style="margin-bottom:14px;font-size:0.92rem">
                Worth a look:{' '}
                <a href={`/contributors/${interestingNeighbor.artist_id}/`}>
                  {interestingNeighbor.name}
                </a>{' '}
                is credited for {interestingNeighborRoleSummary} — a different kind of role than
                {roleSummary ? ` ${contributor.name}'s ${roleSummary}` : ` ${contributor.name}'s`}.
              </p>
            )
          }
          <div class="contributor-grid">
            {neighbors.map((neighbor) => (
              <a
                class={`contributor-card${isBackgroundOnlyRoleProfile(neighbor.role_text_examples, neighbor.role_categories) ? " contributor-card--muted" : ""}`}
                href={`/contributors/${neighbor.artist_id}/`}
              >
                <span class="contributor-card__name">
                  {neighbor.name}
                  {interestingNeighbor && neighbor.artist_id === interestingNeighbor.artist_id && (
                    <span class="tag tag--highlight" style="margin-left:6px">
                      Different role
                    </span>
                  )}
                </span>
                <span class="contributor-card__id">#{neighbor.artist_id} · linked identity</span>
              </a>
            ))}
          </div>
        </section>
      ) : (
        <p class="lede" style="max-width:720px;margin-top:28px;font-size:0.95rem">
          No other contributor is indexed alongside {contributor.name} on a documented release
          yet. <a href="/contributors/">Browse the full directory</a> to find someone else worth
          following.
        </p>
      )
    }

    {
      evidenceHops.length > 0 && (
        <section aria-label="Documented evidence" style="margin-top:28px">
          <p class="eyebrow" style="margin-bottom:10px">Documented evidence</p>
          <EvidencePanel class="evidence-card" hops={evidenceHops} />
        </section>
      )
    }
  </section>
</BaseLayout>
