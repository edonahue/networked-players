---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import type { ChallengeV2 } from '../../data/challenge';
import challengeData from '../../../public/data/challenge.v3.json';
import { connectedCatalogAlbums } from '../../data/connectedAlbums';

const challenge = challengeData as ChallengeV2;
const albums = connectedCatalogAlbums(challenge);

const description =
  'Pick an album to open a focused, bounded network view of its documented contributors — click any name to recenter, filter by role to fade the rest.';
---

<BaseLayout title="Explore the network" description={description}>
  <section class="prose shell" style="padding-bottom:8px">
    <p class="eyebrow">Explore</p>
    <h1>Explore the network around a record.</h1>
    <p class="lede">
      Pick an album to open a focused view of its documented contributors. Click any name to
      recenter the network around them, or filter by role to fade everything else without
      hiding it.
    </p>
  </section>

  <section class="shell" aria-label="Album grid" style="padding-bottom:72px">
    <div class="album-grid" data-testid="explore-album-grid">
      {albums.map((album) => <AlbumCard album={album} hrefBase="/explore/" />)}
    </div>
  </section>
</BaseLayout>
