---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModeCard from '../../components/ModeCard.astro';

const description =
  'The play hub: deduction games over documented music credits. Guess the contributor who connects two records, then open the evidence.';
---

<BaseLayout title="Play" description={description}>
  <section class="prose shell" style="padding-bottom:8px">
    <p class="eyebrow">Play</p>
    <h1>Pick a game off the shelf.</h1>
    <p class="lede">
      Every mode here runs on the same two records and the same liner-note evidence — just a
      different way of getting to the connection between them.
    </p>
  </section>

  <section class="shell" aria-label="Game modes" style="padding-bottom:24px">
    <div class="mode-grid">
      <ModeCard
        title="Connection Guesser"
        kicker="Flagship"
        tone="teal"
        status="live"
        href="/play/connection/"
        description="Two sleeves land on the counter. Who is credited on both? Choose from the tray, spend clues carefully, then open the liner notes."
      />
      <ModeCard
        title="Connection of the Day"
        kicker="Daily"
        tone="gold"
        status="live"
        href="/play/daily/"
        description="One frozen connection per local calendar day. Keep a streak and share your result without revealing the answer."
      />
      <ModeCard
        title="Record Routes"
        kicker="Path guessing"
        tone="teal"
        status="live"
        href="/play/routes/"
        description="Guess how many credits separate two real records, then reveal the full path — one hop, or a hidden bridge in between."
      />
      <ModeCard
        title="Connect Two Records"
        kicker="Search"
        tone="gold"
        status="live"
        href="/play/connect/"
        description="Pick any two albums yourself and search for a documented credit route between them — no pre-dealt pair."
      />
      <ModeCard
        title="Explore the network"
        kicker="Browse & recenter"
        tone="rust"
        status="live"
        href="/explore/"
        description="A focused, bounded view of one record's credited contributors. Click any name to recenter, filter by role to fade the rest."
      />
      <ModeCard
        title="Album connections"
        kicker="Browse & reveal"
        tone="rust"
        status="live"
        href="/albums/"
        description="The original mode: open an album, guess what links it onward, and reveal the documented path hop by hop."
      />
      <ModeCard
        title="Cohorts"
        kicker="Curated sets"
        tone="teal"
        status="live"
        href="/cohorts/"
        description="Curated album pairs scored against the credit graph, with difficulty and hop counts — a synthetic example today, with reviewed sets to follow."
      />
      <ModeCard
        title="Contributors"
        kicker="Browse people"
        tone="gold"
        status="live"
        href="/contributors/"
        description="Every documented contributor in the graph, searchable by name or role. Open anyone's page to see their records and who they connect to."
      />
    </div>
  </section>

  <section class="prose shell" style="padding-top:0;padding-bottom:72px">
    <p class="lede" style="font-size:0.95rem">
      Looking for the earliest artist-path demo? It lives in the{' '}
      <a href="/demo/">archive</a>.
    </p>
  </section>
</BaseLayout>
