---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConnectStage from '../../../components/ConnectStage.astro';

// Connect Two Records (ADR 0051): the first search UI in the app -- pick
// any two albums in the pathfinding graph's scope and search for a
// documented route between them, rather than playing a pre-dealt round.
const description =
  'Pick any two albums and search for a documented credit route between them, with evidence at every hop.';
---

<BaseLayout title="Connect Two Records" description={description}>
  <section class="prose shell u-pb-0">
    <p class="eyebrow">Connect Two Records</p>
    <h1 class="h1-intro">How are these two records connected?</h1>
  </section>

  <ConnectStage />

  <section class="prose shell u-pt-28 u-pb-72">
    <p class="lede lede--md">
      Search covers the records in this catalog and the players around them, not all of Discogs
      (see <a href="/about/">the full picture</a>). Most pairs of unrelated records have
      no documented connection within a few hops — that's a correct result, not a failed one.
    </p>
  </section>
</BaseLayout>

<script>
  import { initConnect } from '../../../game/connect';
  initConnect();
</script>
