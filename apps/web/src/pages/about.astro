---
import BaseLayout from "../layouts/BaseLayout.astro";
import about from "../data/about.json";
import { catalogStats } from "../data/catalogStats";

// The stats paragraphs below quote real counts, not decorative round
// numbers -- previously hardcoded and left stale across three catalog
// expansions (140 -> 179 albums; see git history for the same mistake
// repeating).
const stats: Record<string, string> = Object.fromEntries(
  Object.entries(catalogStats).map(([key, value]) => [key, String(value)]),
);

function withStats(paragraph: string): string {
  return paragraph.replace(/{{(\w+)}}/g, (_match, token: string) => {
    const value = stats[token];
    if (value === undefined) {
      throw new Error(
        `about.json paragraph references unknown stat "${token}"`,
      );
    }
    return value;
  });
}
---

<BaseLayout title="About" description={about.lede} pageType="article">
  <article class="prose shell">
    <p class="eyebrow">{about.eyebrow}</p>
    <h1>{about.title}</h1>
    <p class="lede">{about.lede}</p>

    {
      about.sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p set:html={withStats(p)} />
          ))}
        </>
      ))
    }

    <div class="callout">
      The connections demo runs on a small, curated subset of releases
      fetched via the private seed's release list — too small a fraction to
      reconstruct real collection membership.
      <a class="text-link" href="/demo/">Open the demo →</a>
    </div>
  </article>
</BaseLayout>
