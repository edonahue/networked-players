---
// Album shelf search/sort/decade-filter (PR G). Markup shell only -- all
// wiring lives in game/albumsDirectory.ts (initAlbumsDirectory()), matching
// ContributorsDirectory.astro's split. Every album renders here
// server-side (no fetch, no result cap -- this is a browse surface), sorted
// by title by default so the no-JS baseline is already a sensible order.
// The decade <select> only ships its "All decades" default option here --
// the actual decade list depends on which years are really present in the
// data, so it's populated by the same JS that reads the cards' own
// data-album-year attributes (no JS means no decade options beyond "All",
// same no-JS ceiling search/sort already have).
import AlbumCard from "./AlbumCard.astro";
import type { AlbumV2 } from "../data/challenge";
import { ALBUM_SORT_OPTIONS, ALL_DECADES } from "../game/albumsDirectory";

interface Props {
  albums: AlbumV2[];
  /** ADR 0067: when given, albums absent from this set render with an
   * honest "No documented path yet" tag instead of being silently omitted
   * from the shelf. Omit entirely (default: every album counts as
   * connected) for any caller that doesn't have a meaningful
   * connected/unconnected split. */
  connectedAlbumIds?: Set<string>;
}

const { albums, connectedAlbumIds } = Astro.props;
const sortedByTitle = [...albums].sort((a, b) =>
  a.title.localeCompare(b.title),
);
const unconnectedCount = connectedAlbumIds
  ? albums.filter((album) => !connectedAlbumIds.has(album.id)).length
  : 0;
---

<div class="albums-directory" data-testid="albums-directory">
  <div class="albums-directory__controls">
    <label for="albums-search">Search albums</label>
    <input
      id="albums-search"
      type="text"
      autocomplete="off"
      placeholder="Search by title or artist…"
      data-albums-search
    />
    <label for="albums-sort">Sort by</label>
    <select id="albums-sort" data-albums-sort>
      {
        ALBUM_SORT_OPTIONS.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))
      }
    </select>
    <label for="albums-decade">Decade</label>
    <select id="albums-decade" data-albums-decade>
      <option value={ALL_DECADES}>All decades</option>
    </select>
  </div>

  <p
    class="albums-directory__status"
    data-albums-status
    role="status"
    aria-live="polite"
  >
    {albums.length} album{albums.length === 1 ? "" : "s"}.
  </p>
  {
    unconnectedCount > 0 && (
      // "connected to the credit graph" would overclaim -- these albums
      // are real graph nodes with real neighbors, just not yet an endpoint
      // of a documented challenge.v2 path (ADR 0067).
      <p class="albums-directory__note" data-albums-unconnected-note>
        {unconnectedCount} without a documented path yet.
      </p>
    )
  }

  <div class="album-grid" data-testid="album-grid">
    {
      sortedByTitle.map((album) => (
        <AlbumCard
          album={album}
          connected={connectedAlbumIds ? connectedAlbumIds.has(album.id) : true}
        />
      ))
    }
  </div>
</div>
