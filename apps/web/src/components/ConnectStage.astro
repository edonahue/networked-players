---
// Connect Two Records (ADR 0051): pick any two albums in the pathfinding
// graph's scope and search for a documented route between them. The role
// filter radio group (ADR 0053, extended in a Phase 2 follow-up slice)
// restricts the same search to a specific kind of credit end to end --
// Behind the Glass (producer/engineer/mixer), Rhythm Section (drums/bass),
// or Guitar Paths (guitar) -- reusing this page and the same published
// pathfinding graph rather than a separate mode/page per filter. Radio
// buttons, not independent checkboxes: only one filter (or none) applies
// per search. Markup shell only -- all wiring lives in game/connect.ts
// (initConnect()), matching RoutesStage.astro's split.
//
// Each picker is a real WAI-ARIA combobox (ADR 0059 Phase 5 PR 4): the
// input carries role="combobox" and aria-autocomplete="list"; the results
// list is role="listbox"; each result is role="option" with a stable,
// picker-namespaced id (connect-picker-a-option-N / connect-picker-b-
// option-N) so aria-activedescendant on the input can point at exactly one
// option in exactly one listbox -- two independent pickers, zero id
// collision between them. The per-picker result-count region announces
// match counts to screen readers without stealing focus from the input.
---

<div class="connect-stage" data-testid="connect-stage" data-phase="idle">
  <div class="connect-picker-row">
    <div class="connect-picker" data-picker="a">
      <label for="connect-input-a">First record</label>
      <input
        id="connect-input-a"
        type="text"
        autocomplete="off"
        placeholder="Search an album or artist…"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="connect-picker-a-listbox"
        data-picker-input
      />
      <ul
        id="connect-picker-a-listbox"
        class="connect-picker__results"
        role="listbox"
        tabindex="-1"
        aria-label="First record matches"
        data-picker-results
        hidden
      ></ul>
      <p class="visually-hidden" role="status" data-picker-count></p>
      <div class="connect-picker__selected" data-picker-selected hidden></div>
    </div>
    <button
      type="button"
      class="button connect-swap"
      data-connect-swap
      aria-label="Swap first and second record"
      disabled
    >
      ⇄
    </button>
    <div class="connect-picker" data-picker="b">
      <label for="connect-input-b">Second record</label>
      <input
        id="connect-input-b"
        type="text"
        autocomplete="off"
        placeholder="Search an album or artist…"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="connect-picker-b-listbox"
        data-picker-input
      />
      <ul
        id="connect-picker-b-listbox"
        class="connect-picker__results"
        role="listbox"
        tabindex="-1"
        aria-label="Second record matches"
        data-picker-results
        hidden
      ></ul>
      <p class="visually-hidden" role="status" data-picker-count></p>
      <div class="connect-picker__selected" data-picker-selected hidden></div>
    </div>
  </div>

  <fieldset class="connect-mode-toggle-group" data-connect-mode-group>
    <legend>Route filter</legend>
    <label class="connect-mode-toggle">
      <input
        type="radio"
        name="connect-mode"
        value="none"
        data-connect-mode-option
        checked
      />
      Any documented route
    </label>
    <label class="connect-mode-toggle">
      <input
        type="radio"
        name="connect-mode"
        value="behind-the-glass"
        data-connect-mode-option
      />
      Behind the Glass — only producer/engineer/mixer credits
    </label>
    <label class="connect-mode-toggle">
      <input
        type="radio"
        name="connect-mode"
        value="rhythm-section"
        data-connect-mode-option
      />
      Rhythm Section — only drums/bass credits
    </label>
    <label class="connect-mode-toggle">
      <input
        type="radio"
        name="connect-mode"
        value="guitar-paths"
        data-connect-mode-option
      />
      Guitar Paths — only guitar credits
    </label>
  </fieldset>

  <div class="connect-actions">
    <button type="button" class="button primary" data-connect-search disabled>
      Find the connection
    </button>
    <button
      type="button"
      class="button"
      data-connect-copy-link
      hidden
    >
      Copy link
    </button>
  </div>

  <div class="connect-status" data-connect-status role="status" aria-live="polite" hidden></div>
  <p class="visually-hidden" role="status" data-connect-announce></p>
  <p
    class="visually-hidden"
    aria-live="assertive"
    role="alert"
    data-connect-announce-assertive
  ></p>

  <p class="connect-empty-state" data-connect-empty-state>
    Pick two records above, then search to find a documented connection
    between them.
  </p>

  <div class="connect-results" data-connect-results hidden>
    <section data-connect-result="primary">
      <p class="eyebrow" data-connect-eyebrow tabindex="-1">
        Shortest documented route
      </p>
      <p class="connect-route-length" data-connect-route-length></p>
      <details class="connect-why" data-connect-why-primary hidden>
        <summary>Why this route?</summary>
        <p class="connect-explain" data-connect-explain-primary></p>
      </details>
      <div class="connect-timeline" data-connect-hops></div>
    </section>
    <section data-connect-result="alternate" hidden>
      <p class="eyebrow">Distinct alternate route</p>
      <p class="connect-route-length" data-connect-route-length-alt></p>
      <p class="connect-explain" data-connect-explain></p>
      <div class="connect-timeline" data-connect-hops-alternate></div>
    </section>
  </div>
</div>
