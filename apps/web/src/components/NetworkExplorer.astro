---
// Network Explorer (Phase 2 Slice G, ADR 0052): a focused, bounded,
// non-force-directed expandable graph. SVG, not Canvas -- see ADR 0052 for
// why (bounded node counts, real focusable/labeled DOM elements for
// accessibility, no physics-simulation dependency). Markup shell only; all
// data/layout/interaction wiring lives in game/networkExplorer.ts +
// the page's own script (matching RoutesStage.astro/ConnectStage.astro's
// split).
interface Props {
  initialArtistId: number;
  initialLabel: string;
}
const { initialArtistId, initialLabel } = Astro.props;
---

<div
  class="explorer-stage"
  data-testid="explorer-stage"
  data-phase="idle"
  data-initial-artist-id={initialArtistId}
  data-initial-label={initialLabel}
>
  <div class="explorer-role-filter" data-explorer-role-filter role="group" aria-label="Filter by role">
  </div>

  <div class="explorer-status" data-explorer-status role="status" aria-live="polite" hidden></div>
  <div
    class="visually-hidden"
    data-explorer-status-assertive
    aria-live="assertive"
    role="alert"
  ></div>

  <div class="explorer-info-panel" data-explorer-info-panel hidden>
    <p class="lede explorer-info-panel__summary" data-explorer-info-summary></p>
    <p class="lede explorer-info-panel__worth-a-look" data-explorer-info-worth-a-look hidden></p>
    <p class="lede explorer-info-panel__empty" data-explorer-info-empty hidden>
      No documented connections from here in this bounded view.
    </p>
    <p class="lede explorer-info-panel__links" data-explorer-info-links></p>
  </div>

  <p class="lede explorer-center-link" data-explorer-center-link hidden></p>

  <div
    class="explorer-trail"
    data-explorer-trail
    role="group"
    aria-label="Recently centered on"
    hidden
  ></div>

  <svg
    class="explorer-svg"
    data-explorer-svg
    viewBox="0 0 320 320"
    role="group"
    aria-label="Network explorer graph — select a record's connections to recenter. Drag empty space to pan, scroll or pinch to zoom."
  >
    <!-- Pan/zoom viewport (graph-expansion Phase 1, plan §6): every real
         node/edge stays inside this one <g>, which the pan/zoom transform
         (translate + scale) is applied to as a whole -- neither layer's
         own rendering logic changes at all. -->
    <g data-explorer-viewport>
      <g data-explorer-edges></g>
      <g data-explorer-nodes></g>
    </g>
  </svg>

  <p class="explorer-truncated-note" data-explorer-truncated hidden>
    <span data-explorer-truncated-count></span>
    <button type="button" data-explorer-show-more hidden></button>
  </p>

  <div
    class="explorer-evidence-drawer"
    data-explorer-evidence-drawer
    role="region"
    aria-label="Connection evidence"
    tabindex="-1"
    hidden
  >
    <button
      type="button"
      class="explorer-evidence-drawer__close"
      data-explorer-evidence-close
      aria-label="Close evidence"
    >
      ×
    </button>
    <div data-explorer-evidence-content></div>
  </div>
</div>
