---
import type { AlbumV2 } from "../data/challenge";
import { coverFor } from "../data/albumArt";

interface Props {
  album: AlbumV2;
  /** Where this card links -- defaults to the album detail page; Explore's
   * grid passes "/explore/" to link into the network view instead. */
  hrefBase?: string;
  /** Whether this album has a documented challenge.v2 path. Defaults to
   * true so every existing caller (the homepage's featured section,
   * Explore's grid) is unaffected -- only the full-catalog album shelf
   * (ADR 0067) passes false for the handful of albums with no documented
   * connection yet. */
  connected?: boolean;
}

const { album, hrefBase = "/albums/", connected = true } = Astro.props;
// Presentation art comes from the album-art registry (ADR 0045), never from
// frozen artifact fields; fall back to any legacy embedded cover, then to the
// polished placeholder.
const cover = coverFor(album.id) ?? album.cover_image;
---

<a
  class="album-card"
  href={`${hrefBase}${album.id}/`}
  data-album-id={album.id}
  data-album-title={album.title}
  data-album-artist={album.artist}
  data-album-year={album.year ?? ""}
  data-album-connected={connected ? "true" : "false"}
>
  {
    cover ? (
      <img
        class="album-card__cover"
        src={cover.uri150}
        width="150"
        height="150"
        loading="lazy"
        alt={`Cover art for ${album.title}`}
        data-art-fallback="disc"
      />
    ) : (
      <span class="album-card__placeholder" aria-hidden="true">
        <span class="album-card__placeholder-disc" />
      </span>
    )
  }
  <span class="album-card__title">{album.title}</span>
  <span class="album-card__meta">
    {album.artist}
    {album.year ? ` · ${album.year}` : ""}
  </span>
  {
    !connected && (
      <span class="tag tag--unconnected">Not yet connected</span>
    )
  }
</a>
